# Production reverse proxy for the apex (served by the v2 box since the cutover).
#
# This file is the real running configuration. It was reconstructed from the v2
# box on 2026-08-17, where it had diverged from the repo and lived only on that
# one disk: the committed version had drifted into a draft that could not run at
# all (pre-2.8 `basicauth` spelling, a literal `<bcrypt-hash>` placeholder, and
# basic auth over the Plausible script path, which would have blocked analytics
# for every visitor). Keep them in step from here — a `git diff` against the box
# should be empty.
#
# Required in `.env` (compose passes it through to the caddy service):
#
#   CADDY_BASICAUTH_HASH  — bcrypt hash guarding the two ops subdomains.
#                           Generate with:
#                             docker compose exec caddy caddy hash-password
#                           Username is `admin`; only the hash lives in .env, so
#                           no credential is committed here.
#
#                           **Double every `$` when writing it into .env.**
#                           Compose interpolates `$` in .env values, and a
#                           bcrypt hash contains three of them, so
#                             CADDY_BASICAUTH_HASH=$2a$14$abc...
#                           reaches Caddy as a 24-character stub with the middle
#                           eaten, while
#                             CADDY_BASICAUTH_HASH=$$2a$$14$$abc...
#                           arrives intact. This bites silently: a mangled hash
#                           still answers 401, so the ops UIs look protected and
#                           are simply impossible to log into. Cost an hour on
#                           2026-08-17. Check with:
#                             docker compose exec caddy sh -c \
#                               'echo ${#CADDY_BASICAUTH_HASH}'   # must be 60
#
# If that variable is missing, Caddy **refuses to load this config** with
# "username and password are required" rather than starting up with the ops UIs
# unprotected. Verified 2026-08-17. Fail-closed is the intended behaviour: a
# proxy that will not boot is far better than one quietly serving GlitchTip and
# Plausible to the internet.

{
    email powerpioneer@pm.me
}

# The signed-tile route, shared by the apex and by `v2.` — see below for why
# `v2.` still serves it after the cutover.
#
# `Access-Control-Allow-Origin` names the apex and only the apex: after the
# cutover the apex is the one public web origin, so a single value is correct
# and there is nothing for bunny to mix up (it does not reliably honour
# `Vary: Origin`). Changing this value is what blanks the map if the CDN is not
# purged afterwards — the edge keeps the old header for a year.
(tiles) {
    route /_tiles/* {
        # HMAC verification — API returns 204 if exp+sig is valid for
        # X-Original-URI, 403 otherwise. file_server only runs on 204.
        forward_auth api:8000 {
            uri /api/tiles/verify?{query}
            header_up X-Original-URI {uri}
        }

        # Strip prefix so file_server resolves /var/tiles/<tier>.pmtiles.
        uri strip_prefix /_tiles

        # Headers MUST come before file_server. file_server is terminal;
        # handlers after it do not run. With `route` the literal order is
        # preserved, so listing header directives here puts them on the
        # response header map before file_server uses it.
        header Cache-Control "public, max-age=31536000, immutable"
        header Access-Control-Allow-Origin "https://wheretogoforgreatweather.com"
        header Access-Control-Allow-Methods "GET, HEAD, OPTIONS"
        header Access-Control-Expose-Headers "Content-Length, Content-Range, ETag"
        header Access-Control-Max-Age "86400"
        header Vary "Origin"

        root * /var/tiles
        file_server
    }
}

wheretogoforgreatweather.com {
    encode zstd gzip

    # Baseline response headers for the one public origin. None existed before
    # 2026-11-01, in Caddy or in Next. Deliberately modest:
    # - HSTS at one day and without includeSubDomains or preload, so a
    #   mistake costs a day, not a year. Raise it once the apex has served
    #   HTTPS cleanly for a while.
    # - CSP carries frame-ancestors only. That blocks clickjacking of sign-in
    #   and checkout, and nothing here frames the site. A full policy has to
    #   allow Paddle.js, Plausible, GlitchTip and MapLibre's blob workers, so
    #   it ships separately, starting as Report-Only.
    # Site-level, so the tile route gets them too. All of them are harmless on
    # a range response.
    header {
        Strict-Transport-Security "max-age=86400"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "frame-ancestors 'none'"
    }

    import tiles

    route /api/* {
        reverse_proxy api:8000
    }

    route /* {
        reverse_proxy web:3000
    }
}

# `www` exists only to send people to the apex.
www.wheretogoforgreatweather.com {
    redir https://wheretogoforgreatweather.com{uri} permanent
}

# The former staging host. Everything redirects to the apex except the tiles:
# bunny.net's pull zone fetches `/_tiles/*` from this hostname, so that route
# stays here verbatim (same HMAC forward_auth) rather than moving the CDN origin
# as part of the cutover. The tiles route comes first; `route` blocks keep their
# written order, and file_server ends the request before the redirect is seen.
v2.wheretogoforgreatweather.com {
    encode zstd gzip

    import tiles

    route /* {
        redir https://wheretogoforgreatweather.com{uri} permanent
    }
}

# Ops UIs are subdomains rather than subpaths because both GlitchTip and
# Plausible emit absolute URLs for their static assets and break under path
# stripping. Each exposes exactly the paths that must stay unauthenticated —
# the ones whose callers hold their own credential, or none at all — and puts
# everything else behind basic auth.

glitchtip.v2.wheretogoforgreatweather.com {
    encode zstd gzip

    # Event ingestion authenticates with the DSN's own public key, so it must
    # bypass basic auth. With basic auth in front of these paths Caddy answers
    # 401 and no event ever reaches GlitchTip — which is why every project read
    # "waiting for events" until 2026-08-17. Note this is the path the *browser*
    # uses; server-side senders reach glitchtip-web:8000 directly and never
    # traverse this block at all (the internal compose network has no egress,
    # so they could not resolve this hostname even if they wanted to).
    @ingest path_regexp ^/api/[0-9]+/(envelope|store|security|minidump)/
    handle @ingest {
        reverse_proxy glitchtip-web:8000
    }

    # The UI stays behind basic auth.
    handle {
        basic_auth {
            admin {env.CADDY_BASICAUTH_HASH}
        }
        reverse_proxy glitchtip-web:8000
    }
}

plausible.v2.wheretogoforgreatweather.com {
    encode zstd gzip

    # The tracking script and its event endpoint are fetched by every visitor's
    # browser, so they cannot sit behind basic auth. NEXT_PUBLIC_PLAUSIBLE_SRC
    # points at /js/script.js here; the web app's built-in default
    # (/_plausible/js/script.js on the apex) is NOT routed by this file, so that
    # variable must stay set. Serving the script first-party through the main
    # domain instead would survive more ad blockers — a deliberate change, not a
    # thing to drift into.
    @public path /js/* /api/event /api/health
    handle @public {
        reverse_proxy plausible:8000
    }

    handle {
        basic_auth {
            admin {env.CADDY_BASICAUTH_HASH}
        }
        reverse_proxy plausible:8000
    }
}
